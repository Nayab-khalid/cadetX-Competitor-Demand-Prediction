{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CadetX job posting record",
  "description": "One job posting. Column contract shared by all four members - see docs/data-schema.md.",
  "type": "object",
  "required": [
    "job_id",
    "company_name",
    "job_title",
    "job_description",
    "posting_date",
    "location",
    "job_url"
  ],
  "properties": {
    "job_id": {"type": "string", "minLength": 1, "description": "Unique within the file, company-prefixed"},
    "company_name": {"type": "string", "minLength": 1},
    "job_title": {"type": "string", "minLength": 1},
    "job_description": {"type": "string", "minLength": 20},
    "posting_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "location": {"type": "string"},
    "job_url": {"type": "string", "pattern": "^https?://"},
    "employment_type": {"type": "string"},
    "job_category": {"type": "string"},
    "seniority_level": {"type": "string", "enum": ["Junior", "Mid", "Senior", "Lead", "Principal", ""]},
    "extracted_skills": {"type": "string", "description": "JSON list of canonical skill names"},
    "skill_categories": {"type": "string"},
    "tech_stack_tags": {"type": "string"},
    "cleaned_description": {"type": "string"},
    "posting_week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
    "posting_month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "scraped_date": {"type": "string"},
    "job_status": {"type": "string", "enum": ["active", "closed", ""]},
    "salary_range": {"type": "string"},
    "sector": {"type": "string"}
  },
  "additionalProperties": true
}
